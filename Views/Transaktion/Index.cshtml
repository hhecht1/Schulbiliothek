@model IEnumerable<SchulbibliothekAP14.Models.Transaktion>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Datum)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bemerkung)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BuchId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TransaktionTypId)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Datum)
            </td>
            <td>
                @Html.DisplayFor(model => item.Bemerkung)
            </td>
            <td>
                @Html.DisplayFor(model => item.BuchId)
            </td>
            <td>
                @Html.DisplayFor(model => item.TransaktionTypId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
