@model SchulbibliothekAP14.Models.Transaktion

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Transaktion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Datum" class="control-label"></label>
                <input asp-for="Datum" class="form-control" />
                <span asp-validation-for="Datum" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Bemerkung" class="control-label"></label>
                <input asp-for="Bemerkung" class="form-control" />
                <span asp-validation-for="Bemerkung" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BuchId" class="control-label"></label>
                <select asp-for="BuchId" class="form-control">
                    <option></option>
                    @foreach (var buch in (List<Buch>)ViewData["Buecher"])
                    {
                        <option value="@buch.Id">@buch.Titel</option>
                    }
                </select>
                <span asp-validation-for="BuchId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TransaktionTypId" class="control-label"></label>
                <select asp-for="TransaktionTypId" class="form-control">
                    <option></option>
                    @foreach (var transaktiontyp in (List<TransaktionTyp>)ViewData["Transaktiontypen"])
                    {
                        <option value="@transaktiontyp.Id">@transaktiontyp.Beschreibung</option>
                    }
                </select>
                <span asp-validation-for="TransaktionTypId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PersonId" class="control-label"></label>
                <select asp-for="PersonId" class="form-control">
                    <option></option>
                    @foreach (var person in (List<Person>)ViewData["Personen"])
                    {
                        <option value="@person.Id">@person.Vorname @person.Nachname</option>
                    }
                </select>
                <span asp-validation-for="PersonId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
