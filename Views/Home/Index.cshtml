@using SchulbibliothekAP14.Viewmodels
@model HomeViewmodel

<div class="container mt-4">

    <!-- Filter -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Transaktionen filtern
            </h5>
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <!-- Suche -->
                    <div class="col-md-4">
                        <label asp-for="Suche" class="form-label"></label>

                        <input asp-for="Suche" class="form-control" placeholder="Titel suchen ..."
                               onchange="this.form.submit()" />
                    </div>


                    <!-- Transaktionstyp -->
                    <div class="col-md-3">
                        <label asp-for="TransaktionTypId" class="form-label"></label>

                        <select asp-for="TransaktionTypId" class="form-select" onchange="this.form.submit()">

                            <option value="">Alle</option>
                            <option value="1">Ausleihe</option>
                            <option value="2">Rückgabe</option>

                        </select>
                    </div>


                    <!-- Person -->
                    <div class="col-md-3">
                        <label asp-for="PersonId" class="form-label"></label>

                        <select asp-for="PersonId" class="form-select" onchange="this.form.submit()">

                            <option value="">Alle Personen</option>

                            @foreach (var person in (List<Person>)ViewData["Personen"])
                            {
                                <option value="@person.Id">
                                    @person.Vorname @person.Nachname
                                </option>
                            }

                        </select>
                    </div>


                    <!-- Anzahl -->
                    <div class="col-md-2">
                        <label asp-for="Anzahl" class="form-label"></label>

                        <select asp-for="Anzahl" class="form-select" onchange="this.form.submit()">

                            <option value="">Alle</option>
                            <option value="15">15</option>
                            <option value="30">30</option>

                        </select>
                    </div>


                    <!-- Zurücksetzen -->
                    <div class="col-12">

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Zurücksetzen
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Transaktionsliste -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                Transaktionen
            </h5>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Titel</th>
                            <th>Typ</th>
                            <th>Zeitpunkt</th>
                            <th>Person</th>
                            <th>Bild</th>
                            <th>Bemerkung</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <!-- Titel -->
                                <td>
                                    <strong>
                                        @item.Titel
                                    </strong>
                                </td>


                                <!-- Transaktionstyp -->
                                <td>

                                    @if (item.TransaktionTyp == "Ausleihe")
                                    {
                                        <span class="badge bg-primary">
                                            Ausleihe
                                        </span>
                                    }
                                    else if (item.TransaktionTyp == "Rückgabe")
                                    {
                                        <span class="badge bg-success">
                                            Rückgabe
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.TransaktionTyp
                                        </span>
                                    }

                                </td>


                                <!-- Datum -->
                                <td>
                                    @item.Datum.ToString("dd.MM.yyyy")
                                </td>


                                <!-- Person -->
                                <td>
                                    @item.Person
                                </td>


                                <!-- Bild -->
                                <td>

                                    <img src="/Person/Image/@item.PersonId" class="rounded-circle border"
                                         style="width:50px; height:50px; object-fit:cover;" alt="Bild von @item.Person" />

                                </td>


                                <!-- Bemerkung -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Bemerkung))
                                    {
                                        @item.Bemerkung
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            –
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>